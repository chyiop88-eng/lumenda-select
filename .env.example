# Configure these as PRIVATE environment variables in Render; never commit real values.
DATABASE_URL=postgresql://username:password@hostname:5432/database
ADMIN_USERNAME=lumenda_owner
ADMIN_PASSWORD=replace-with-a-fresh-random-password-of-16-plus-characters
ADMIN_SESSION_SECRET=replace-with-64-or-more-random-characters
PORT=3000

# Stripe Checkout: DISABLED unless the merchant explicitly configures and approves it.
# Use test keys and Stripe's test Dashboard first. Never store keys in GitHub.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://lumenda-select-preview.onrender.com/
# Enabling live requires live secret + webhook secret + STRIPE_MODE=live + explicit live approval.
STRIPE_LIVE_APPROVED=false

# PayPal Orders v2 merchant checkout. Store only in PRIVATE Render Environment.
# First test using PayPal Developer Sandbox. Real money is ALWAYS disabled by default.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_LIVE_APPROVED=false
# If PayPal becomes your checkout provider, STRIPE_CHECKOUT_ENABLED should remain false.
